# Extracted MPHexEditor package. The pristine source is kept as the tracked
# mphexeditor.zip at the repo root; the unpacked tree is a build input plus
# its own compiler output, so it does not belong in the repo.
/mphexeditor/

# Binaries shipped next to the program.
software/*.exe
software/*.EXE
software/*.dll
software/*.DLL

# Free Pascal / Lazarus unit output directory (lib/<cpu>-<os>/...)
software/lib/

# Lazarus per-developer session state and generated artifacts.
#   .lps: IDE session (open files, cursor positions, breakpoints); the IDE
#         writes a new one when it saves the project or quits.
#   .res: compiled resource blob; lazbuild regenerates it from AsProgrammer.ico
#         and the manifest and version info settings stored in the .lpi.
# AsProgrammer.lpi, the Lazarus project file, stays tracked: README step 5
# ("Open AsProgrammer.lpi with lazarus") needs it, and without it lazbuild
# fails with "File not found".
AsProgrammer.exe
AsProgrammer.lps
AsProgrammer.res

# Runtime / generated data files.
#   settings.xml: written by the program itself (selected hardware, locale,
#                 speeds). Purely local state, ignored in every location.
#   software/chiplist.xml: working copy the program reads; the canonical one
#                 is chiplist.xml at the repo root, which is tracked and which
#                 README step 4 tells you to copy here.
#   AsProgrammer.pot: i18n template regenerated by the Lazarus IDE i18n pass,
#                 not by lazbuild. The .po translations next to it are tracked.
settings.xml
software/chiplist.xml
software/lang/AsProgrammer.pot

# The Lazarus IDE's backups of the files it saves: old copies, not source.
software/backup/
